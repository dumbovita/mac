font-size = 17

theme = light:Flexoki Light,dark:Flexoki Dark
background-opacity = 0.90
minimum-contrast = 1.1

window-padding-x = 8
window-padding-y = 8
window-padding-balance = true
window-padding-color = extend

cursor-style-blink = false
cursor-text = cell-foreground
cursor-click-to-move = true

scrollback-limit = 20000000
mouse-hide-while-typing = true

copy-on-select = clipboard
clipboard-trim-trailing-spaces = true

bell-features = no-audio,no-system,no-attention,no-title,no-border
link-previews = false

working-directory = home
window-inherit-working-directory = false
confirm-close-surface = false

macos-titlebar-style = tabs
macos-option-as-alt = true

keybind = global:cmd+enter=toggle_quick_terminal
quick-terminal-position = top

shell-integration-features = cursor,sudo,title,ssh-env,ssh-terminfo

notify-on-command-finish = unfocused
notify-on-command-finish-action = no-bell,notify
notify-on-command-finish-after = 30s
