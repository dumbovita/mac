{
  "allowNonWorkspaceAccess": true,
  "colorScheme": "dark",
  "model": "gemini-3.8-flash-high",
  "permissions": {
    "allow": [
      "command(*)",
      "read_url(*)",
      "mcp(*)"
    ],
    "deny": [
      "command(rm -rf /)",
      "command(rm -rf /*)",
      "command(rm -rf ~)",
      "command(rm -rf ~/*)",
      "command(rm -rf /Users/kemal*)",
      "command(rm -rf /Users/kemal)",
      "command(rm -rf /Users/kemal/*)",
      "command(rm -rf /Users)",
      "command(rm -rf /System)",
      "command(rm -rf /Library)",
      "command(rm -rf /private)",
      "command(rm -rf /usr)",
      "command(rm -rf /bin)",
      "command(rm -rf /sbin)",
      "command(mkfs*)",
      "command(diskutil erase*)",
      "command(diskutil partitionDisk*)",
      "command(diskutil reformat*)",
      "command(dd *of=/dev/*)",
      "command(dd if=* of=/dev/*)",
      "command(:(){ :|:\u0026 };:)",
      "command(chmod -R 777 /)",
      "command(chown -R * /)",
      "command(shutdown*)",
      "command(reboot*)",
      "command(halt*)",
      "command(poweroff*)"
    ],
    "ask": [
      "command(rm *)",
      "command(rmdir *)",
      "command(unlink *)",
      "command(find * -delete)",
      "command(trash *)",
      "command(shred *)",
      "command(git reset --hard*)",
      "command(git clean -f*)",
      "command(git restore .)",
      "command(git restore --staged .)",
      "command(git checkout -- .)",
      "command(git push *--force*)",
      "command(git push *-f*)",
      "command(git branch -D*)",
      "command(killall *)",
      "command(pkill *)",
      "command(kill -9 *)",
      "command(brew uninstall *)",
      "command(brew remove *)",
      "command(sudo *)",
      "command(curl * | sh)",
      "command(curl * | bash)",
      "command(curl * | zsh)",
      "command(wget * | sh)",
      "command(wget * | bash)",
      "command(wget * | zsh)",
      "command(chmod -R 777 ~)"
    ]
  },
  "toolPermission": "always-proceed"
}
